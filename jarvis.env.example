# Copy to ~/.claude/jarvis/jarvis.env and edit. jarvisd.sh, listen.sh and
# keymap.sh read this file; every line is a plain shell assignment.
# Everything here has a working default - set only what you want to change.

# ------------------------------------------------------------------ language
# Everything he says and listens for comes from locales/<lang>.toml - the wake
# word, the stop words, his manner, and the models that can handle that
# language. `python3 lang.py list` shows what is present.
# JARVIS_LANG=en                  # en (default) | ru

# ---------------------------------------------------------------- who he serves
# Your name, used in the assistant's system prompt. Empty: he says "the owner of
# this computer" and never uses a name.
# JARVIS_OWNER=

# -------------------------------------------------------------------- the keys
# A key press is the one signal Jarvis always trusts: it is your own hand, so it
# beats any microphone guess. Names are pynput names - run
#   uv run ~/.claude/jarvis/probe_key.py
# in your own terminal, press the key, and copy the line it prints.
#
# One press = "switch to me": ends your sentence while he listens, interrupts him
# while he thinks or talks, wakes him when idle. Two presses = drop it entirely.
# JARVIS_TAP_KEYS="<f18>"
# JARVIS_DONE_KEYS="<space>"      # "answer now", only while he is listening
# JARVIS_OFF_KEYS="<esc>"         # "shut up and wait"
# JARVIS_DOUBLE_TAP=0.4           # seconds that count as a double press
# JARVIS_DEBOUNCE=0.18            # ignore repeats from one physical press
#
# No Input Monitoring permission, or no spare key? Bind jarvis-key.sh to a
# shortcut in Shortcuts.app instead - it needs no permission at all:
#   jarvis-key.sh          one press
#   jarvis-key.sh double   two presses

# ------------------------------------------- turning a macro key into F18 (opt.)
# keymap.sh remaps one key on one keyboard, so End keeps working everywhere else.
# Find your keyboard: bash ~/.claude/jarvis/keymap.sh list
# JARVIS_KEYMAP_VENDOR=1234       # VendorID of your keyboard
# JARVIS_KEYMAP_PRODUCT=567       # ProductID
# JARVIS_KEYMAP_SRC=0x4D          # HID usage you press: End
# JARVIS_KEYMAP_DST=0x6D          # HID usage it becomes: F18

# ------------------------------------------------------------- wake word / mic
# JARVIS_WAKE_ENGINE=vosk         # vosk (offline, default) | oww | porcupine
# JARVIS_VOSK_MODEL=              # path to a Vosk model dir, if not the default
# JARVIS_SILENCE=1.5              # seconds of quiet that end your phrase
# JARVIS_FOLLOWUP=1.5             # keep listening this long after his reply
# JARVIS_MIN_LEVEL=300            # raise it in a noisy room
# JARVIS_PICOVOICE_KEY=           # only for JARVIS_WAKE_ENGINE=porcupine

# ------------------------------------------------------------------- his voice
# The backend and the voice come from the locale; these override for one run.
# JARVIS_BACKEND=                 # piper | vosk | edge | system
# JARVIS_VOICE=                   # a piper voice, e.g. en_US-lessac-medium
# JARVIS_EXTRA_VOICES=            # more piper voices for install.sh to fetch
# JARVIS_EDGE_VOICE=              # the network fallback, e.g. en-GB-RyanNeural
# JARVIS_ASR_MODEL=               # a parakeet-mlx repo id, if not the locale's
# JARVIS_CALL_GUARD=              # off = speak aloud even during a video call

# --------------------------------------------------------------- long-term memory
# A vector store, or anything else that answers a search. Declared in
# config/memory.toml; this points at a different file.
# JARVIS_MEMORY=                  # path to a memory .toml

# ------------------------------------------------------------------ voice lock
# Off unless models/campplus.onnx is there and a profile was recorded with
# `uv run enroll_voice.py`. It fails open: no model, no profile, or audio too
# short and everyone is let through.
# JARVIS_SPK=on                   # off = never check who is talking
# JARVIS_SPK_MIN_SEC=1.0          # below this there is not enough voice to judge
# JARVIS_STRANGER_LINE=           # what he says to someone who is not you

# ------------------------------------------------------------------- answering
# JARVIS_MODEL=sonnet             # model for voice answers; haiku is fastest
# JARVIS_CWD=                     # working dir for `claude -p`, default: session/
# JARVIS_MCP=                     # 1 = start claude with MCP servers (+~2 s)
# JARVIS_DEBUG=                   # 1 = print what Vosk hears, and timings

# --------------------------------------------------- optional companion agents
# JARVIS_TARGET=own               # own | orch (send questions to another window)
#
# Rooms are declared in config/rooms.toml, not here. Two env vars per room
# override that file without editing it - handy for a second machine where
# the folders differ:
# JARVIS_ROOM_CHIEF_SESSION=      # session name to look for
# JARVIS_ROOM_CHIEF_DIR=          # folder it starts in
# JARVIS_ROOMS=                   # one more .toml file, or a folder of them
# JARVIS_ACTIONS=                 # the same for actions

# ---------------------------------------------------------------------- telegram
# tg_listen.py only, and only when the Keychain holds jarvis-telegram-token
# and jarvis-telegram-chat.
# JARVIS_TG_NAME=                 # the name this session answers to
# JARVIS_TG_POLL=10               # seconds per long-poll wait
